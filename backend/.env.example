DATABASE_URL=sqlite:///./data.db

# mock | transformers | ollama
MODEL_BACKEND=mock

BASE_MODEL_PATH=unsloth/gemma-3-4b-it-bnb-4bit
ADAPTER_PATH=../outputs/adapter

OLLAMA_HOST=http://localhost:11434
OLLAMA_FINETUNED_MODEL=resume-jd-scorer
OLLAMA_BASE_MODEL=gemma3:4b

GEMINI_API_KEY=

# Exact-match allowed origins (add your deployed frontend URL here).
CORS_ORIGINS=["http://localhost:3000"]
# Regex fallback so any localhost port is allowed in local dev. Set to an
# empty string to disable and rely on CORS_ORIGINS alone.
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?
